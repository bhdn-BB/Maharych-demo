AI_SERVICE_HTTP_URL=http://localhost:8000
# Same Google OAuth client ID as NextAuth. No client secret is needed here.
GOOGLE_CLIENT_ID=
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
