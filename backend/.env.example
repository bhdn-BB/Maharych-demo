# Local backend development. Copy to .env; Compose configures these separately.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=12345678
DB_NAME=maharych
ADMIN_EMAILS=
JWT_SECRET=change-me-to-a-random-string-of-32-chars-or-more
CORS_ORIGINS=http://localhost:3000
