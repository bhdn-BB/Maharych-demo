# Root Docker Compose settings. Copy to .env and set Google OAuth credentials.
JWT_SECRET=change-me-to-a-random-string-of-32-chars-or-more
NEXTAUTH_SECRET=change-me-nextauth-secret-before-sharing
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated emails that become admins after signing in with Google (admin panel at /admin).
ADMIN_EMAILS=
# Database and broker credentials (required; choose your own values).
POSTGRES_PASSWORD=change-me-db-password
RABBITMQ_USER=maharych
RABBITMQ_PASSWORD=change-me-broker-password

# Optional: overrides voice_ai_service/.env for the AI containers
# GEMINI_API_KEY=your-gemini-api-key   (uncomment to override voice_ai_service/.env)
